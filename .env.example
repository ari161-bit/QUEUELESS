JWT_SECRET=replace-with-a-long-random-string
# Supabase: Project Settings -> Database -> Connection string -> "Transaction" pooler (port 6543)
# is the one to use for serverless (Vercel) deployments.
POSTGRES_URL=postgresql://postgres.xxxxxxxxxxxx:your-password@aws-0-region.pooler.supabase.com:6543/postgres
PORT=3001
